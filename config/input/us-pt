// US international layout, tweaked for Brazilian Portuguese:
// - keeps all us(intl) dead keys (á é í ó ú ã õ via dead_tilde, ç via XCompose)
// - Shift+' produces dead_tilde (so Shift+' then a => ã) instead of dead_diaeresis
//   This mirrors the "us-acentos" console behaviour where ' produces first level
//   and the tilde lives with the quote key.
default partial alphanumeric_keys
xkb_symbols "basic" {
    include "us(intl)"

    name[Group1] = "English (US, intl, PT)";

    key <AC11> { [ dead_acute, dead_tilde, apostrophe, quotedbl ] };
};