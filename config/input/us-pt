// US international layout, tweaked for Brazilian Portuguese:
// - keeps all us(intl) accent dead keys (á é í ó ú ã õ, ç via XCompose)
// - Shift+' produces dead_tilde (so Shift+' then a => ã) instead of dead_diaeresis
// - Shift+` produces quotedbl " (freeing the old location of the tilde, which
//   now lives on Shift+'), so double quotes stay on an easy key
default partial alphanumeric_keys
xkb_symbols "basic" {
    include "us(intl)"

    name[Group1] = "English (US, intl, PT)";

    key <AC11> { [ dead_acute, dead_tilde, apostrophe, quotedbl ] };
    key <TLDE> { [ dead_grave, quotedbl,         grave, asciitilde ] };
};